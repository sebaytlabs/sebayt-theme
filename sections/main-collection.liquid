<section class="section">
  <div class="wrap">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="grid" style="margin-top: 28px;">
          {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
      {%- else -%}
        <p class="muted" style="margin-top: 28px;">Nothing here yet.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection" }
{% endschema %}
