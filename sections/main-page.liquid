<section class="page-head">
  <div class="wrap">
    <p class="kick" style="color: var(--gold-light);">{{ shop.name }}</p>
    <h1>{{ page.title }}</h1>
  </div>
</section>
<div class="pattern" aria-hidden="true"></div>
<section class="page-body">
  <div class="wrap">
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{ "name": "Page" }
{% endschema %}
