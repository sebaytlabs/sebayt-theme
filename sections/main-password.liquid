<section class="gate">
  <div>
    <p class="kick" style="color: var(--gold-light);">{{ shop.name }}</p>
    <h1>Opening soon</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      <label class="skip" for="password">Password</label>
      <input id="password" type="password" name="password" placeholder="Password" autocomplete="current-password">
      <button class="button" type="submit">Enter</button>
      {%- if form.errors -%}<p style="color: #ff7a7a;">Wrong password.</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Password page" }
{% endschema %}
