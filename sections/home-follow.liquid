<section class="section sand">
  <div class="wrap">
    <p class="kick">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="find">
      {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" rel="noopener">YouTube</a>{%- endif -%}
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" rel="noopener">Facebook</a>{%- endif -%}
      {%- if settings.social_threads != blank -%}<a href="{{ settings.social_threads }}" rel="noopener">Threads</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Follow",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "Stay close" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Use it, then tell us what's missing" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "SimpleBrain is out and it's free. We read every comment and every reply, and that's how it gets better. Find us as @sebaytlabs." }
  ],
  "presets": [{ "name": "Follow" }]
}
{% endschema %}
