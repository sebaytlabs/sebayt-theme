{%- assign p = section.settings.product -%}
<section class="section sand">
  <div class="wrap split">
    <div>
      <p class="kick">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <p>{{ section.settings.text2 }}</p>
      {%- if p != blank -%}
        <p><a class="button" href="{{ p.url }}">{{ section.settings.button_label }}</a></p>
      {%- endif -%}
    </div>
    <div class="shot">
      {%- if p.featured_image -%}
        {{ p.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: p.title }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "kicker", "label": "Small line above", "default": "The first thing we built" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "SimpleBrain" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A notes app that doesn't make you set anything up. Type a thought, file it, link your notes together and watch how they connect." },
    { "type": "textarea", "id": "text2", "label": "Second paragraph", "default": "It's built to be the free alternative to Roam, Obsidian and Notion. No account. Your notes are plain files in a folder you own." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get it free" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
