<section class="page-head">
  <div class="wrap">
    <p class="kick" style="color: var(--gold-light);">{{ shop.name }}</p>
    <h1>{{ page.title }}</h1>
  </div>
</section>
<div class="pattern" aria-hidden="true"></div>
<section class="page-body">
  <div class="wrap">
    {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    {%- form 'contact', class: 'contact-form', style: 'max-width: 560px; display: grid; gap: 16px;' -%}
      {%- if form.posted_successfully? -%}
        <p class="rte"><strong>Thank you. Your message was sent.</strong> We will reply by email.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p role="alert" style="color: #a33;">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label>Name
        <input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </label>
      <label>Email
        <input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </label>
      <label>Message
        <textarea name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </label>
      <div><button type="submit" class="button">Send message</button></div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Contact form" }
{% endschema %}
