<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.collection != blank -%}<a href="{{ section.settings.collection.url }}">View all</a>{%- endif -%}
    </div>
    {%- assign shown = section.settings.collection.products | default: collections.all.products -%}
    {%- if shown.size > 0 -%}
      <div class="grid">
        {%- for product in shown limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted">Products will show up here once you add some.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest" },
    { "type": "collection", "id": "collection", "label": "Collection (empty shows all products)" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
