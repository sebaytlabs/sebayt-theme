<section class="section">
  <div class="wrap">
    <h1>{{ blog.title }}</h1>
    {%- paginate blog.articles by 10 -%}
      <div class="grid" style="margin-top: 28px;">
        {%- for article in blog.articles -%}
          <article class="card"><a href="{{ article.url }}"><div class="info">
            <p class="title">{{ article.title }}</p>
            <span class="muted">{{ article.published_at | date: '%b %-d, %Y' }}</span>
            <p class="muted" style="margin-top: 8px;">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </div></a></article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog" }
{% endschema %}
